<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}</title>
    <link rel="icon" href="{{ favicon_url }}">
    <link rel="stylesheet" href="{{ css_url }}">
    <script>document.documentElement.classList.add('js');</script>
    {% if analytics_domain %}
    <script defer data-domain="{{ analytics_domain }}" src="https://plausible.io/js/script.manual.js"></script>
    <script>
        window.plausible = window.plausible || function () {
            (window.plausible.q = window.plausible.q || []).push(arguments);
        };
        document.addEventListener('DOMContentLoaded', function () {
            plausible('pageview', { u: '{{ analytics_page_url }}' });
        });
    </script>
    {% endif %}
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <button class="sidebar-toggle" type="button" aria-controls="site-sidebar" aria-expanded="false">
        Menu
    </button>

    <div class="site-shell">
        <aside id="site-sidebar" class="site-sidebar">
            <nav aria-label="Course navigation">
                <a class="sidebar-home{% if navigation.home.active %} active{% endif %}" href="{{ navigation.home.url }}">
                    {{ navigation.home.title }}
                </a>
                {% for group in navigation.groups %}
                <section class="sidebar-group">
                    {% if group.title %}
                    <h2>{{ group.title }}</h2>
                    {% endif %}
                    <ul>
                        {% for page in group.pages %}
                        <li>
                            {% if page.url %}
                            <a class="{% if page.active %}active{% endif %}{% if page.external %} sidebar-feedback{% endif %}" href="{{ page.url }}"{% if page.external %} target="_blank" rel="noopener noreferrer"{% endif %}>
                                {{ page.title }}
                            </a>
                            {% else %}
                            <span class="sidebar-disabled" aria-disabled="true">
                                {{ page.title }}
                                {% if page.release_label %}
                                <small>{{ page.release_label }}</small>
                                {% endif %}
                            </span>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                </section>
                {% endfor %}
            </nav>
        </aside>

        <main id="main-content" class="site-main">
            <header class="logo-strip">
                <img src="{{ logo_url }}" height="{{ logo_height }}" alt="LIGHT logo">
                <div class="logo-strip-title">{{ header_title }}</div>
            </header>

            {% if hero_url %}
            <div class="markdown-hero" style="--hero-width: {{ hero_width }};">
                <img src="{{ hero_url }}" alt="{{ page_title }} banner">
            </div>
            {% endif %}

            {% if week and theme %}
            <div class="week-title-banner">
                <h1>Week {{ week }}: {{ theme }}</h1>
            </div>
            {% elif page_heading %}
            <div class="page-title-banner">
                <h1>{{ page_heading }}</h1>
            </div>
            {% endif %}

            {% if slides_pdf_url %}
            <p class="resource-link">
                <a href="{{ slides_pdf_url }}">Download slides (PDF)</a>
            </p>
            {% endif %}

            <section
                class="pagination-shell{% if no_pagination %} unpaginated{% endif %}"
                {% if not no_pagination %}
                data-paginator
                data-section-count="{{ section_count }}"
                data-previous-week-url="{{ previous_week_url }}"
                data-next-week-url="{{ next_week_url }}"
                {% endif %}
            >
                {% if not no_pagination %}
                <div class="step-caption" data-step-caption>Step 1 of {{ section_count }}</div>
                <div class="progress-track" aria-hidden="true">
                    <div class="progress-fill" data-progress-fill></div>
                </div>

                <div class="pagination-controls" aria-label="Section navigation">
                    <div class="control-slot control-slot-left">
                        <button class="pager-button" type="button" data-previous-button>
                            Previous
                        </button>
                    </div>
                    <div class="control-slot control-slot-center">
                        <label class="visually-hidden" for="section-jump">Jump to page</label>
                        <select id="section-jump" data-section-select>
                            {% for section in sections %}
                            <option value="{{ section.index }}">{{ section.step }}. {{ section.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="control-slot control-slot-right">
                        <button class="pager-button" type="button" data-next-button>
                            Next
                        </button>
                    </div>
                </div>
                {% endif %}

                <div class="sections-stack">
                    {% for section in sections %}
                    <article class="section{% if not no_pagination %} page-section{% endif %}"{% if section.anchor %} id="{{ section.anchor }}"{% endif %} data-section-index="{{ section.index }}" data-section-title="{{ section.title }}">
                        <h2>{{ section.title }}</h2>
                        {{ section.html | safe }}
                    </article>
                    {% endfor %}
                </div>
            </section>
        </main>
    </div>

    <script src="{{ js_url }}" defer></script>
</body>
</html>
